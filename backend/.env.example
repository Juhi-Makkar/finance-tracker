# Backend Environment Configuration
# Copy this file to backend/.env and fill in your values

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=fintrack-db

# ========== JWT SECRET ==========
# Generate a strong secret key for JWT tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ========== EMAIL CONFIGURATION (Gmail) ==========
# Required for email verification and password reset
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password

# How to get Gmail App Password:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your OS)
# 4. Generate and copy the 16-character password
# 5. Paste it here as EMAIL_PASS (remove spaces)

# ========== FRONTEND URL ==========
# Used for email verification links sent to users
FRONTEND_URL=http://localhost:3000

# For production, change to:
# FRONTEND_URL=https://yourdomain.com
