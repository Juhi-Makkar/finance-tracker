# Backend Environment Configuration
# Copy this file to backend/.env and fill in your values

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=fintrack-db

# ========== JWT SECRET ==========
# Generate a strong secret key for JWT tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ========== EMAIL CONFIGURATION (Gmail) ==========
# Required for email verification and password reset
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password

# How to get Gmail App Password:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your OS)
# 4. Generate and copy the 16-character password
# 5. Paste it here as EMAIL_PASS (remove spaces)

# ========== PUBLIC APPLICATION URLs ==========
# BACKEND_URL is used in the email verification link. It must be reachable by
# the person opening the email (not an expired temporary tunnel URL).
BACKEND_URL=http://localhost:5000

# FRONTEND_URL is the public pages directory where users are redirected after
# their email is verified.
FRONTEND_URL=http://localhost:5000/pages

# For production, change both to your live HTTPS domains, for example:
# BACKEND_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com/pages
